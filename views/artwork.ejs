<% pageTitle = art.title + ' — Original Hawaii Art Print | Wailea Art' %>
<% metaDescription = (art.description || ('Original Hawaii art print: ' + art.title + '.')) + (art.dimensions ? ' Available in ' + art.dimensions + '.' : '') + ' Shipped from Wailea, Maui.' %>
<% canonicalPath = '/art/' + art.slug %>
<% noIndex = false %>
<% ogImage = art.image_path %>
<%- include('partials/header') %>

<main class="wrap">
  <div class="artwork-page">
    <div class="card-img orientation-<%= art.orientation || 'portrait' %> artwork-hero" data-carousel<% if (art.images.length > 1) { %> data-multi<% } %>>
      <% art.images.forEach(function(imgPath, i) { %>
        <img src="<%= imgPath %>" alt="<%= art.title %> - Original Hawaii Art Print by Wailea Art" loading="lazy" class="carousel-slide <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>" draggable="false" oncontextmenu="return false;">
      <% }); %>
      <% if (art.images.length > 1) { %>
        <button type="button" class="carousel-arrow carousel-arrow-prev" aria-label="Previous image">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="carousel-arrow carousel-arrow-next" aria-label="Next image">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
        <div class="carousel-dots">
          <% art.images.forEach(function(_, i) { %>
            <span class="carousel-dot <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>"></span>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="artwork-details">
      <a href="/" class="artwork-back-link">&larr; Back to gallery</a>
      <h1><%= art.title %></h1>
      <p class="card-dimensions"><%= art.dimensions %><% if (art.material) { %> &middot; <%= art.material %><% } %></p>
      <% if (art.description) { %>
        <p class="artwork-description"><%= art.description %></p>
      <% } %>
      <div class="card-price artwork-price">
        $<%= art.price_retail.toFixed(2) %>
      </div>
      <button
        class="btn btn-primary btn-block js-open-buy"
        data-id="<%= art.id %>"
        data-title="<%= art.title %>"
        data-dimensions="<%= art.dimensions %>"
        data-material="<%= art.material %>"
        data-image="<%= art.image_path %>"
        data-retail="<%= art.price_retail %>"
        data-bulk-pkg="<%= art.price_bulk_packaging %>"
        data-bulk-nopkg="<%= art.price_bulk_no_packaging %>"
      >Buy this print</button>
    </div>
  </div>

  <% if (related.length > 0) { %>
    <div class="artwork-related">
      <h2>More art you might like</h2>
      <div class="gallery">
        <% related.forEach(function(r) { %>
          <div class="card">
            <a href="/art/<%= r.slug %>" class="card-img orientation-<%= r.orientation || 'portrait' %>" style="display:flex;">
              <img src="<%= r.images[0] %>" alt="<%= r.title %> - Original Hawaii Art Print by Wailea Art" loading="lazy">
            </a>
            <div class="card-body">
              <h3 class="card-title"><a href="/art/<%= r.slug %>" style="color:inherit; text-decoration:none;"><%= r.title %></a></h3>
              <p class="card-dimensions"><%= r.dimensions %></p>
              <div class="card-price">$<%= r.price_retail.toFixed(2) %></div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": <%- JSON.stringify(art.title) %>,
    "image": "<%= siteUrl %><%= art.image_path %>",
    "description": <%- JSON.stringify((art.description || 'Original Hawaii art print by Wailea Art.') + (art.material ? ' Material: ' + art.material : '') + (art.dimensions ? ' Size: ' + art.dimensions : '')) %>,
    "brand": { "@type": "Brand", "name": "Wailea Art" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "USD",
      "price": "<%= art.price_retail.toFixed(2) %>",
      "availability": "https://schema.org/InStock",
      "url": "<%= siteUrl %>/art/<%= art.slug %>"
    }
  }
  </script>
</main>

<!-- Image lightbox -->
<div class="lightbox-overlay" id="lightboxOverlay">
  <button type="button" class="lightbox-close" id="lightboxClose" aria-label="Close">&times;</button>
  <button type="button" class="lightbox-arrow lightbox-arrow-prev" id="lightboxPrev" aria-label="Previous image">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  <img id="lightboxImage" src="" alt="" draggable="false" oncontextmenu="return false;">
  <button type="button" class="lightbox-arrow lightbox-arrow-next" id="lightboxNext" aria-label="Next image">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>
</div>

<!-- Buy modal -->
<div class="modal-overlay" id="buyModal">
  <div class="modal">
    <button class="modal-close" id="closeModal" aria-label="Close">&times;</button>
    <h3 id="modalTitle">Print title</h3>
    <p id="modalDimensions" style="color: var(--ink-soft); font-size: 0.85rem; margin-top: -10px; margin-bottom: 16px;"></p>

    <div class="field-group">
      <label>Order type</label>
      <div class="toggle-row" id="modeToggle">
        <button type="button" data-mode="retail" class="active">Retail</button>
        <button type="button" data-mode="bulk">Bulk (10+)</button>
      </div>
    </div>

    <div class="field-group hidden" id="packagingGroup">
      <label>Packaging</label>
      <div class="toggle-row" id="packagingToggle">
        <button type="button" data-packaging="1" class="active">With packaging</button>
        <button type="button" data-packaging="0">No packaging</button>
      </div>
      <p class="packaging-note" id="packagingNote"></p>
    </div>

    <div class="field-group">
      <label for="qtyInput">Quantity</label>
      <input type="number" id="qtyInput" min="1" value="1" step="1">
      <p class="packaging-note" id="qtyHint"></p>
    </div>

    <div class="order-total">
      <span>Total</span>
      <span class="amt" id="orderTotal">$45.00</span>
    </div>

    <p class="modal-error hidden" id="modalError"></p>

    <button class="btn btn-primary btn-block" id="checkoutBtn" style="margin-top:14px;">
      Checkout with Stripe
    </button>
  </div>
</div>

<%- include('partials/site-footer') %>
<script src="/js/gallery.js"></script>
