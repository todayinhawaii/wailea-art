<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Wailea Art | Original Hawaii & Maui Art Prints' %></title>

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png">

  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Original Hawaii and Maui art prints from Wailea Art. Shop wall art inspired by Wailea, Kapalua, Lahaina, Oahu, Honolulu and the Hawaiian islands. Retail and bulk pricing available.' %>">
  <meta name="keywords" content="Hawaii art, Hawaiian art, Hawaii artists, Maui art, Wailea art, Wailea Maui art, Kapalua art, Lahaina art, Oahu art, Honolulu art, Kauai art, Big Island art, Hawaii wall art, Hawaii art prints, Hawaii art prints for sale, Maui wall art, Hawaiian art prints, Hawaiian home decor, Hawaii gift shop art, Maui gift art, tropical wall art, island art prints, original Hawaii paintings, Hawaii art gallery, buy Hawaii art online, bulk Hawaii art prints, wholesale Hawaii art, Hawaii art for retailers">
  <meta name="robots" content="<%= typeof noIndex !== 'undefined' && noIndex ? 'noindex, nofollow' : 'index, follow' %>">
  <link rel="canonical" href="<%= siteUrl %><%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">

  <!-- Open Graph / social sharing -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Wailea Art">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'Wailea Art | Original Hawaii & Maui Art Prints' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Original Hawaii and Maui art prints from Wailea Art.' %>">
  <meta property="og:url" content="<%= siteUrl %><%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
  <meta property="og:image" content="<%= siteUrl %><%= ogImage %>">
  <% } %>
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <!-- Structured data: helps Google understand this is a Hawaii-based art business -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ArtGallery",
    "name": "Wailea Art",
    "url": "<%= siteUrl %>",
    "description": "Original Hawaii and Maui art prints, available retail and in bulk, from Wailea Art.",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "HI",
      "addressLocality": "Wailea",
      "addressCountry": "US"
    },
    "areaServed": ["Wailea", "Maui", "Kapalua", "Lahaina", "Oahu", "Honolulu", "Kauai", "Big Island", "Hawaii"]
  }
  </script>
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="brand">Wailea <span>Art</span></a>
      <nav class="main-nav">
        <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Gallery</a>
        <a href="/blog" class="<%= page === 'blog' ? 'active' : '' %>">Journal</a>
        <a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About</a>
        <a href="/contact" class="<%= page === 'contact' ? 'active' : '' %>">Contact</a>
      </nav>
    </div>
  </header>
  <div class="wave-rule">
    <svg viewBox="0 0 1200 14" preserveAspectRatio="none">
      <path d="M0,7 C100,0 200,14 300,7 C400,0 500,14 600,7 C700,0 800,14 900,7 C1000,0 1100,14 1200,7" />
    </svg>
  </div>
