<% pageTitle = 'Contact Wailea Art | Hawaii Art Prints, Custom & Wholesale Orders' %>
<% metaDescription = 'Contact Wailea Art for questions about Hawaii and Maui art prints, custom orders, or wholesale and bulk pricing for retailers across the Hawaiian islands.' %>
<% canonicalPath = '/contact' %>
<% noIndex = false %>
<%- include('partials/header') %>

<main class="wrap">
  <div class="page-content">
    <h1>Contact</h1>
    <p class="lede">Questions about a piece, custom sizing, or a bulk order? Send a note below.</p>

    <% if (typeof sent !== 'undefined' && sent) { %>
      <div class="alert alert-success">Thanks — your message has been sent. We'll get back to you soon.</div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form class="stack" method="POST" action="/contact">
      <div class="field-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required>
      </div>
      <div class="field-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="field-group">
        <label for="business_name">Business name (optional)</label>
        <input type="text" id="business_name" name="business_name" placeholder="If you're contacting us on behalf of a shop or gallery">
      </div>
      <div class="field-group">
        <label class="checkbox-pill" style="width: fit-content;">
          <input type="checkbox" id="wants_wholesale" name="wants_wholesale" value="1">
          <span>I'd like to showcase Wailea Art in my shop or gallery</span>
        </label>
      </div>
      <div class="field-group hidden" id="businessAddressGroup">
        <label for="business_address">Business address</label>
        <textarea id="business_address" name="business_address" rows="3" placeholder="Street address, city, state, zip"></textarea>
      </div>
      <div class="field-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Send message</button>
    </form>
  </div>
</main>

<script>
  document.getElementById('wants_wholesale').addEventListener('change', function () {
    document.getElementById('businessAddressGroup').classList.toggle('hidden', !this.checked);
  });
</script>

<%- include('partials/site-footer') %>
