<% pageTitle = 'Admin — Wailea Art' %>
<% noIndex = true %>
<%- include('../partials/header') %>

<main class="wrap admin-shell">
  <div class="admin-header">
    <h1 style="margin:0;">Admin</h1>
    <form method="POST" action="/admin/logout">
      <button class="btn btn-secondary btn-sm" type="submit">Log out</button>
    </form>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <% if (typeof unprotectedCount !== 'undefined' && unprotectedCount > 0) { %>
    <div class="admin-card" style="background: #fdf6e3; border-color: #e8d9a8; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
      <div>
        <strong>Image protection</strong>
        <p style="margin: 4px 0 0; font-size: 0.88rem; color: var(--ink-soft);">
          <%= unprotectedCount %> image<%= unprotectedCount === 1 ? '' : 's' %> from before this feature existed are still showing full resolution publicly. One click makes them safe too.
        </p>
      </div>
      <form method="POST" action="/admin/regenerate-previews" id="protectArtForm" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').textContent='Protecting…';">
        <button class="btn btn-primary btn-sm" type="submit">Protect existing art</button>
      </form>
    </div>
  <% } %>

  <% if (typeof autoContinueProtection !== 'undefined' && autoContinueProtection) { %>
    <script>
      // A batch just finished but more remain — automatically continue
      // after a short pause, so the whole thing finishes on its own
      // without needing repeated manual clicks.
      setTimeout(() => {
        const form = document.getElementById('protectArtForm');
        if (form) form.submit();
      }, 900);
    </script>
  <% } %>

  <div class="admin-grid">
    <div>
      <div class="admin-card">
        <h3>Add new art</h3>
        <form method="POST" action="/admin/artworks" enctype="multipart/form-data" class="stack">
          <div class="field-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required>
          </div>
          <div class="field-group">
            <label for="sku">Internal reference / SKU (optional — only you see this, never shown publicly)</label>
            <input type="text" id="sku" name="sku" placeholder="e.g. RT 537">
          </div>
          <div class="field-group">
            <label for="description">Description (optional)</label>
            <textarea id="description" name="description" rows="3"></textarea>
          </div>
          <div class="field-group">
            <label for="dimensions">Dimensions</label>
            <input type="text" id="dimensions" name="dimensions" placeholder='8.5" x 11"' value='8.5" x 11"'>
          </div>
          <div class="field-group">
            <label for="material">Material</label>
            <input type="text" id="material" name="material" placeholder="e.g. Giclée print on fine art paper">
          </div>
          <div class="field-group">
            <label class="checkbox-pill" style="width: fit-content;">
              <input type="checkbox" name="ships_as_canvas" value="1">
              <span>This ships as a rolled canvas (in a tube)</span>
            </label>
          <div class="field-group">
            <label for="image">Image (JPG, PNG, or WEBP)</label>
            <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" required>
          </div>

          <% if (categories.length > 0) { %>
            <div class="field-group">
              <label>Categories (optional, choose any that apply)</label>
              <div class="checkbox-grid">
                <% categories.forEach(function(cat) { %>
                  <label class="checkbox-pill">
                    <input type="checkbox" name="category_ids" value="<%= cat.id %>">
                    <span><%= cat.name %></span>
                  </label>
                <% }); %>
              </div>
            </div>
          <% } %>

          <div class="field-group">
            <label>Pricing (defaults are prefilled — change only if this piece differs)</label>
            <div class="price-inputs">
              <div>
                <label for="price_retail" style="margin-bottom:4px;">Retail</label>
                <input type="number" step="0.01" id="price_retail" name="price_retail" value="45.00">
              </div>
              <div>
                <label for="price_bulk_packaging" style="margin-bottom:4px;">Bulk, packaged</label>
                <input type="number" step="0.01" id="price_bulk_packaging" name="price_bulk_packaging" value="30.00">
              </div>
              <div>
                <label for="price_bulk_no_packaging" style="margin-bottom:4px;">Bulk, no packaging</label>
                <input type="number" step="0.01" id="price_bulk_no_packaging" name="price_bulk_no_packaging" value="25.00">
              </div>
            </div>
          </div>

          <button class="btn btn-primary btn-block" type="submit">Add to gallery</button>
        </form>
      </div>

      <div class="admin-card">
        <h3>Bulk add art</h3>
        <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">Drag in a batch of images at once (all the same dimensions/pricing/categories). Each becomes its own gallery piece, titled from its filename — edit each one afterward to fine-tune.</p>

        <form method="POST" action="/admin/artworks/bulk" enctype="multipart/form-data" class="stack">
          <div class="field-group">
            <label>Images</label>
            <div class="dropzone" id="bulkDropzone">
              <div id="dropzoneText">Drag images here, or click to browse</div>
              <div id="dropzoneFileList" class="dropzone-filelist"></div>
            </div>
            <input type="file" id="bulkImages" name="images" accept="image/jpeg,image/png,image/webp" multiple hidden required>
          </div>

          <div class="field-group">
            <label for="bulk_dimensions">Dimensions (applied to all)</label>
            <input type="text" id="bulk_dimensions" name="dimensions" placeholder='8.5" x 11"' value='8.5" x 11"'>
          </div>

          <div class="field-group">
            <label for="bulk_material">Material (optional, applied to all)</label>
            <input type="text" id="bulk_material" name="material" placeholder="e.g. Giclée print on fine art paper">
          </div>
          <div class="field-group">
            <label class="checkbox-pill" style="width: fit-content;">
              <input type="checkbox" name="ships_as_canvas" value="1">
              <span>These all ship as rolled canvases (in a tube)</span>
            </label>

          <div class="field-group">
            <label for="bulk_description">Description (optional, applied to all)</label>
            <textarea id="bulk_description" name="description" rows="3"></textarea>
          </div>

          <% if (categories.length > 0) { %>
            <div class="field-group">
              <label>Categories (optional, applied to all)</label>
              <div class="checkbox-grid">
                <% categories.forEach(function(cat) { %>
                  <label class="checkbox-pill">
                    <input type="checkbox" name="category_ids" value="<%= cat.id %>">
                    <span><%= cat.name %></span>
                  </label>
                <% }); %>
              </div>
            </div>
          <% } %>

          <div class="field-group">
            <label>Pricing (applied to all)</label>
            <div class="price-inputs">
              <div>
                <label style="margin-bottom:4px;">Retail</label>
                <input type="number" step="0.01" name="price_retail" value="45.00">
              </div>
              <div>
                <label style="margin-bottom:4px;">Bulk, packaged</label>
                <input type="number" step="0.01" name="price_bulk_packaging" value="30.00">
              </div>
              <div>
                <label style="margin-bottom:4px;">Bulk, no packaging</label>
                <input type="number" step="0.01" name="price_bulk_no_packaging" value="25.00">
              </div>
            </div>
          </div>

          <button class="btn btn-primary btn-block" type="submit" id="bulkSubmitBtn">Add all to gallery</button>
        </form>
      </div>

      <div class="admin-card">
        <h3>Categories</h3>
        <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">These show as pills at the top of your homepage. Drag to set the order — including where "All" appears.</p>

        <ul class="sortable-list" id="categorySortableList">
          <% pillOrder.forEach(function(item) { %>
            <li class="sortable-item" draggable="true" data-id="<%= item.id %>">
              <span class="drag-handle">&#8942;&#8942;</span>
              <span class="item-title"><%= item.isAll ? 'All' : item.name %><% if (item.isAll) { %> <span style="color:var(--ink-soft); font-size:0.78rem;">(shows every piece)</span><% } %></span>
              <% if (!item.isAll) { %>
                <div class="item-actions">
                  <form method="POST" action="/admin/categories/<%= item.id %>/delete" onsubmit="return confirm('Delete this category? It will be removed from any art using it.');">
                    <button class="btn btn-sm" style="background:var(--danger); color:#fff;" type="submit">Delete</button>
                  </form>
                </div>
              <% } %>
            </li>
          <% }); %>
        </ul>
        <div style="display:flex; align-items:center; gap:14px; margin-top:14px;">
          <button class="btn btn-primary" type="button" id="saveCategoryOrderBtn">Save order</button>
          <span id="categoryOrderSaveStatus" style="font-size:0.85rem; opacity:0; transition:opacity 0.3s ease;"></span>
        </div>

        <form method="POST" action="/admin/categories" class="stack" style="margin-top:20px;">
          <div class="field-group" style="display:flex; gap:10px; margin:0; align-items:flex-end;">
            <div style="flex:1;">
              <label for="cat_name">New category name</label>
              <input type="text" id="cat_name" name="name" placeholder="e.g. Ocean" required>
            </div>
            <button class="btn btn-secondary" type="submit">Add</button>
          </div>
        </form>
      </div>

      <div class="admin-card">
        <h3>Gallery order</h3>
        <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">Drag pieces to reorder. Top of the list shows first on the homepage.</p>

        <% if (artworks.length === 0) { %>
          <p style="color: var(--ink-soft); font-size: 0.9rem;">No art yet — add your first piece.</p>
        <% } else { %>
          <div style="margin-bottom: 10px;">
            <label class="checkbox-pill" style="width: fit-content;">
              <input type="checkbox" id="selectAllArtworks">
              <span>Select all</span>
            </label>
          </div>
          <ul class="sortable-list" id="sortableList">
            <% artworks.forEach(function(art) { %>
              <li class="sortable-item" draggable="true" data-id="<%= art.id %>">
                <input type="checkbox" class="artwork-select-checkbox" value="<%= art.id %>" style="width:16px; height:16px; flex-shrink:0;">
                <span class="drag-handle">&#8942;&#8942;</span>
                <img src="<%= art.image_path %>" alt="<%= art.title %>">
                <div class="item-title">
                  <div><%= art.title %><% if (art.sku) { %> <span style="color:var(--ocean); font-size:0.78rem; font-weight:normal;">(<%= art.sku %>)</span><% } %></div>
                  <div style="font-size:0.76rem; color:var(--ink-soft);">
                    <%= art.dimensions %>
                    <% if (art.categories && art.categories.length) { %>
                      &middot; <%= art.categories.map(c => c.name).join(', ') %>
                    <% } %>
                  </div>
                </div>
                <div class="item-actions">
                  <a class="btn btn-secondary btn-sm" href="/admin/artworks/<%= art.id %>/edit">Edit</a>
                  <form method="POST" action="/admin/artworks/<%= art.id %>/<%= art.published ? 'unpublish' : 'publish' %>">
                    <button class="btn btn-sm live-toggle-btn <%= art.published ? 'is-live' : 'is-offline' %>" type="submit">
                      <%= art.published ? '● Live' : '○ Not live' %>
                    </button>
                  </form>
                  <button class="btn btn-secondary btn-sm move-top-btn" type="button">To top</button>
                  <button class="btn btn-secondary btn-sm move-bottom-btn" type="button">To bottom</button>
                  <form method="POST" action="/admin/artworks/<%= art.id %>/delete" onsubmit="return confirm('Delete this piece? This cannot be undone.');">
                    <button class="btn btn-sm" style="background:var(--danger); color:#fff;" type="submit">Delete</button>
                  </form>
                </div>
              </li>
            <% }); %>
          </ul>
          <div style="display:flex; align-items:center; gap:14px; margin-top:14px; flex-wrap: wrap;">
            <button class="btn btn-primary" type="button" id="saveOrderBtn">Save order</button>
            <button class="btn btn-sm" type="button" id="deleteSelectedBtn" style="background:var(--danger); color:#fff; display:none;">Delete selected (<span id="selectedCount">0</span>)</button>
            <span id="orderSaveStatus" style="font-size:0.85rem; opacity:0; transition:opacity 0.3s ease;"></span>
          </div>
        <% } %>
      </div>

    </div>

    <div>
      <div class="admin-card">
        <h3 style="margin:0 0 8px;">Printify</h3>

        <% if (!printifyConfigured) { %>
          <p style="color: var(--ink-soft); font-size: 0.9rem;">Not connected yet — add <code>PRINTIFY_API_TOKEN</code> as an environment variable in Render, then come back here.</p>
        <% } else if (!printifyConnected) { %>
          <p style="color: var(--ink-soft); font-size: 0.9rem;">Your Printify token is connected. Choose which shop to pull products from:</p>
          <a class="btn btn-primary btn-sm" href="/admin/printify/shops">Choose my Printify shop</a>
        <% } else { %>
          <p style="color: var(--ink-soft); font-size: 0.9rem;">
            Connected to <strong><%= printifyShopTitle %></strong>.
            <% if (printifyPendingCount > 0) { %>
              <%= printifyPendingCount %> product<%= printifyPendingCount === 1 ? '' : 's' %> waiting for your review below.
            <% } %>
          </p>
          <div style="display:flex; gap:10px; flex-wrap: wrap;">
            <form method="POST" action="/admin/printify/sync">
              <button class="btn btn-primary btn-sm" type="submit">Sync from Printify</button>
            </form>
            <form method="POST" action="/admin/printify/disconnect" onsubmit="return confirm('Disconnect this Printify shop? Already-imported products will stay in your store.');">
              <button class="btn btn-secondary btn-sm" type="submit">Disconnect shop</button>
            </form>
          </div>

          <% if (printifyPendingCount > 0) { %>
            <div style="margin-top: 20px; border-top: 1px solid var(--sand-line); padding-top: 16px;">
              <h4 style="margin: 0 0 4px; font-size: 0.95rem;">Waiting for your review (<%= printifyPendingCount %> total)</h4>
              <% if (printifyPendingCount > printifyPendingProducts.length) { %>
                <p style="font-size: 0.8rem; color: var(--ink-soft); margin: 0 0 12px;">Showing the most recent <%= printifyPendingProducts.length %> — use "Select all pending" below to act on all <%= printifyPendingCount %> at once, no scrolling required.</p>
              <% } %>

              <div style="background: var(--sand); border: 1px solid var(--sand-line); border-radius: var(--radius); padding: 12px; margin-bottom: 16px;">
                <label class="checkbox-pill" style="width: fit-content; margin-bottom: 10px;">
                  <input type="checkbox" id="selectAllPendingPrintify">
                  <span>Select all <%= printifyPendingCount %> pending products</span>
                </label>
                <div style="display:flex; align-items:center; gap:10px; flex-wrap: wrap;">
                  <% if (storeCategories.length > 0) { %>
                    <select id="bulkPublishCategory" style="padding:6px 10px; border-radius:4px; border:1px solid var(--sand-line); font-size:0.85rem;">
                      <option value="">No category</option>
                      <% storeCategories.forEach(function(cat) { %>
                        <option value="<%= cat.id %>"><%= cat.name %></option>
                      <% }); %>
                    </select>
                  <% } %>
                  <button class="btn btn-primary btn-sm" type="button" id="bulkPublishPendingBtn" disabled>Publish selected (<span id="bulkPublishCount">0</span>)</button>
                  <span id="bulkPublishStatus" style="font-size:0.85rem;"></span>
                </div>
              </div>

              <% printifyPendingProducts.forEach(function(pp) { %>
                <div class="pending-printify-item" style="display:flex; align-items:center; gap:12px; padding: 10px 0; border-bottom: 1px solid var(--sand-line); flex-wrap: wrap;">
                  <input type="checkbox" class="pending-printify-checkbox" value="<%= pp.id %>" style="width:16px; height:16px; flex-shrink:0;">
                  <img src="<%= pp.image_path %>" alt="<%= pp.title %>" style="width:44px; height:56px; object-fit:cover; border-radius:2px; border:1px solid var(--sand-line);">
                  <div style="flex:1; min-width: 140px;">
                    <div><%= pp.title %></div>
                    <div style="font-size:0.78rem; color:var(--ink-soft);">$<%= pp.price.toFixed(2) %></div>
                  </div>

                  <form method="POST" action="/admin/store-products/<%= pp.id %>/publish" style="display:flex; align-items:center; gap:10px; flex-wrap: wrap;">
                    <% if (storeCategories.length > 0) { %>
                      <div style="display:flex; gap:6px; flex-wrap: wrap; max-width: 280px;">
                        <% storeCategories.forEach(function(cat) { %>
                          <label class="checkbox-pill" style="font-size: 0.78rem; padding: 4px 10px;">
                            <input type="checkbox" name="category_ids" value="<%= cat.id %>" <%= pp.selectedCategoryIds.includes(cat.id) ? 'checked' : '' %>>
                            <span><%= cat.name %></span>
                          </label>
                        <% }); %>
                      </div>
                    <% } %>
                    <a class="btn btn-secondary btn-sm" href="/admin/store-products/<%= pp.id %>/edit">Edit</a>
                    <button class="btn btn-primary btn-sm" type="submit">Publish</button>
                  </form>
                </div>
              <% }); %>
            </div>
          <% } %>
        <% } %>
      </div>

      <div class="admin-card" style="background: <%= storeComingSoon ? '#fdf6e3' : 'var(--card)' %>; <%= storeComingSoon ? 'border-color: #e8d9a8;' : '' %>">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap: wrap; gap: 10px;">
          <div>
            <h3 style="margin:0;">Store status</h3>
            <p style="color: var(--ink-soft); font-size: 0.85rem; margin: 4px 0 0;">
              <% if (storeComingSoon) { %>
                Your "Our Store" page currently shows a friendly "coming soon" message to visitors instead of your products.
              <% } else { %>
                Your "Our Store" page is showing your live products to visitors right now.
              <% } %>
            </p>
          </div>
          <form method="POST" action="/admin/store-coming-soon">
            <input type="hidden" name="enabled" value="<%= storeComingSoon ? '0' : '1' %>">
            <button class="btn <%= storeComingSoon ? 'btn-primary' : 'btn-secondary' %> btn-sm" type="submit">
              <%= storeComingSoon ? 'Turn off Coming Soon' : 'Turn on Coming Soon' %>
            </button>
          </form>
        </div>
      </div>

      <div class="admin-card">
        <h3>Add store product</h3>
        <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">Lives on your separate "Our Store" page, apart from your art gallery.</p>
        <form method="POST" action="/admin/store-products" enctype="multipart/form-data" class="stack">
          <div class="field-group">
            <label for="sp_title">Title</label>
            <input type="text" id="sp_title" name="title" required>
          </div>
          <div class="field-group">
            <label for="sp_sku">Internal reference / SKU (optional — only you see this)</label>
            <input type="text" id="sp_sku" name="sku" placeholder="e.g. Printify #1234">
          </div>
          <div class="field-group">
            <label for="sp_description">Description (optional)</label>
            <textarea id="sp_description" name="description" rows="3"></textarea>
          </div>
          <div class="field-group">
            <label for="sp_price">Price</label>
            <input type="number" step="0.01" id="sp_price" name="price" value="25.00">
          </div>
          <div class="field-group">
            <label for="sp_image">Image (JPG, PNG, or WEBP)</label>
            <input type="file" id="sp_image" name="image" accept="image/jpeg,image/png,image/webp" required>
          </div>

          <% if (storeCategories.length > 0) { %>
            <div class="field-group">
              <label>Store categories (optional, choose any that apply)</label>
              <div class="checkbox-grid">
                <% storeCategories.forEach(function(cat) { %>
                  <label class="checkbox-pill">
                    <input type="checkbox" name="category_ids" value="<%= cat.id %>">
                    <span><%= cat.name %></span>
                  </label>
                <% }); %>
              </div>
            </div>
          <% } %>

          <button class="btn btn-primary btn-block" type="submit">Add store product</button>
        </form>
      </div>

      <div class="admin-card">
        <h3>Store categories</h3>
        <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">These show as pills at the top of your "Our Store" page — separate from your art categories.</p>

        <ul class="sortable-list" id="storeCategorySortableList">
          <% storePillOrder.forEach(function(item) { %>
            <li class="sortable-item" draggable="true" data-id="<%= item.id %>">
              <span class="drag-handle">&#8942;&#8942;</span>
              <span class="item-title"><%= item.isAll ? 'All' : item.name %><% if (item.isAll) { %> <span style="color:var(--ink-soft); font-size:0.78rem;">(shows every product)</span><% } %></span>
              <% if (!item.isAll) { %>
                <div class="item-actions">
                  <form method="POST" action="/admin/store-categories/<%= item.id %>/delete" onsubmit="return confirm('Delete this store category? It will be removed from any product using it.');">
                    <button class="btn btn-sm" style="background:var(--danger); color:#fff;" type="submit">Delete</button>
                  </form>
                </div>
              <% } %>
            </li>
          <% }); %>
        </ul>
        <div style="display:flex; align-items:center; gap:14px; margin-top:14px;">
          <button class="btn btn-primary" type="button" id="saveStoreCategoryOrderBtn">Save order</button>
          <span id="storeCategoryOrderSaveStatus" style="font-size:0.85rem; opacity:0; transition:opacity 0.3s ease;"></span>
        </div>

        <form method="POST" action="/admin/store-categories" class="stack" style="margin-top:20px;">
          <div class="field-group" style="display:flex; gap:10px; margin:0; align-items:flex-end;">
            <div style="flex:1;">
              <label for="store_cat_name">New store category name</label>
              <input type="text" id="store_cat_name" name="name" placeholder="e.g. Towels" required>
            </div>
            <button class="btn btn-secondary" type="submit">Add</button>
          </div>
        </form>
      </div>

      <div class="admin-card">
        <h3>Store product order</h3>
        <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">Drag products to reorder. Top of the list shows first on your "Our Store" page.</p>

        <% if (storeProducts.length === 0) { %>
          <p style="color: var(--ink-soft); font-size: 0.9rem;">No store products yet — add your first one above.</p>
        <% } else { %>
          <ul class="sortable-list" id="storeProductSortableList">
            <% storeProducts.forEach(function(sp) { %>
              <li class="sortable-item" draggable="true" data-id="<%= sp.id %>">
                <span class="drag-handle">&#8942;&#8942;</span>
                <img src="<%= sp.image_path %>" alt="<%= sp.title %>">
                <div class="item-title">
                  <div><%= sp.title %><% if (sp.sku) { %> <span style="color:var(--ocean); font-size:0.78rem; font-weight:normal;">(<%= sp.sku %>)</span><% } %></div>
                  <div style="font-size:0.76rem; color:var(--ink-soft);">
                    $<%= sp.price.toFixed(2) %>
                    <% if (sp.categories && sp.categories.length) { %>
                      &middot; <%= sp.categories.map(c => c.name).join(', ') %>
                    <% } %>
                  </div>
                </div>
                <div class="item-actions">
                  <a class="btn btn-secondary btn-sm" href="/admin/store-products/<%= sp.id %>/edit">Edit</a>
                  <form method="POST" action="/admin/store-products/<%= sp.id %>/<%= sp.published ? 'unpublish' : 'publish' %>">
                    <button class="btn btn-sm live-toggle-btn <%= sp.published ? 'is-live' : 'is-offline' %>" type="submit">
                      <%= sp.published ? '● Live' : '○ Not live' %>
                    </button>
                  </form>
                  <button class="btn btn-secondary btn-sm move-top-btn" type="button">To top</button>
                  <button class="btn btn-secondary btn-sm move-bottom-btn" type="button">To bottom</button>
                  <form method="POST" action="/admin/store-products/<%= sp.id %>/delete" onsubmit="return confirm('Delete this store product? This cannot be undone.');">
                    <button class="btn btn-sm" style="background:var(--danger); color:#fff;" type="submit">Delete</button>
                  </form>
                </div>
              </li>
            <% }); %>
          </ul>
          <div style="display:flex; align-items:center; gap:14px; margin-top:14px;">
            <button class="btn btn-primary" type="button" id="saveStoreProductOrderBtn">Save order</button>
            <span id="storeProductOrderSaveStatus" style="font-size:0.85rem; opacity:0; transition:opacity 0.3s ease;"></span>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="admin-store-top">
      <div class="admin-card">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <h3 style="margin:0;">Blog posts</h3>
          <a class="btn btn-secondary btn-sm" href="/admin/posts/new">Write new post</a>
        </div>
        <p style="color: var(--ink-soft); font-size: 0.85rem;">These show up on your Journal page. Drag to reorder, or use the buttons below.</p>

        <% if (posts.length === 0) { %>
          <p style="color: var(--ink-soft); font-size: 0.9rem;">No posts yet — write your first one.</p>
        <% } else { %>
          <ul class="sortable-list" id="postsSortableList">
            <% posts.forEach(function(p) { %>
              <li class="sortable-item" draggable="true" data-id="<%= p.id %>">
                <span class="drag-handle">&#8942;&#8942;</span>
                <% if (/\.(mp4|webm|mov)$/i.test(p.featured_image)) { %>
                  <video src="<%= p.featured_image %>" muted></video>
                <% } else { %>
                  <img src="<%= p.featured_image %>" alt="<%= p.title %>">
                <% } %>
                <div class="item-title"><%= p.title %></div>
                <div class="item-actions">
                  <a class="btn btn-secondary btn-sm" href="/admin/posts/<%= p.id %>/edit">Edit</a>
                  <button class="btn btn-secondary btn-sm move-top-btn" type="button">To top</button>
                  <button class="btn btn-secondary btn-sm move-bottom-btn" type="button">To bottom</button>
                  <form method="POST" action="/admin/posts/<%= p.id %>/delete" onsubmit="return confirm('Delete this post? This cannot be undone.');">
                    <button class="btn btn-sm" style="background:var(--danger); color:#fff;" type="submit">Delete</button>
                  </form>
                </div>
              </li>
            <% }); %>
          </ul>
          <div style="display:flex; align-items:center; gap:14px; margin-top:14px;">
            <button class="btn btn-primary" type="button" id="savePostOrderBtn">Save order</button>
            <span id="postOrderSaveStatus" style="font-size:0.85rem; opacity:0; transition:opacity 0.3s ease;"></span>
          </div>
        <% } %>
      </div>

      <div class="admin-card">
        <h3>Messages</h3>
        <% if (messages.length === 0) { %>
          <p style="color: var(--ink-soft); font-size: 0.9rem;">No messages yet.</p>
        <% } else { %>
          <div style="margin-bottom: 10px;">
            <label class="checkbox-pill" style="width: fit-content;">
              <input type="checkbox" id="selectAllMessages">
              <span>Select all</span>
            </label>
          </div>
          <% messages.forEach(function(m) { %>
            <div class="msg-item" style="display:flex; gap:10px; align-items:flex-start;">
              <input type="checkbox" class="message-select-checkbox" value="<%= m.id %>" style="width:16px; height:16px; flex-shrink:0; margin-top:4px;">
              <div style="flex:1;">
                <% if (m.wants_wholesale) { %>
                  <div style="background:#fdf6e3; border:1px solid #e8d9a8; border-radius:4px; padding:4px 8px; font-size:0.76rem; font-weight:bold; display:inline-block; margin-bottom:4px;">🏪 Wants to showcase in their shop/gallery</div>
                <% } %>
                <div class="msg-meta">
                  <%= m.name %> &middot; <%= m.email %>
                  <% if (m.business_name) { %> &middot; <strong><%= m.business_name %></strong><% } %>
                  &middot; <%= m.created_at %>
                </div>
                <% if (m.business_address) { %>
                  <div style="font-size:0.8rem; color:var(--ink-soft); margin-top:2px;">📍 <%= m.business_address %></div>
                <% } %>
                <div class="msg-body"><%= m.message %></div>
              </div>
            </div>
          <% }); %>

          <div style="display:flex; align-items:center; gap:12px; margin-top:16px; flex-wrap: wrap;">
            <button class="btn btn-sm" type="button" id="deleteSelectedMessagesBtn" style="background:var(--danger); color:#fff; display:none;">Delete selected (<span id="selectedMessagesCount">0</span>)</button>
            <button class="btn btn-primary btn-sm" type="button" id="emailSelectedMessagesBtn" style="display:none;">Email selected (<span id="selectedMessagesCountForEmail">0</span>)</button>
            <button class="btn btn-secondary btn-sm" type="button" id="blockSelectedMessagesBtn" style="display:none;">🚫 Block sender (<span id="selectedMessagesCountForBlock">0</span>)</button>
          </div>

          <div id="messageEmailComposer" class="hidden" style="margin-top:16px; border-top:1px solid var(--sand-line); padding-top:16px;">
            <div class="field-group">
              <label for="marketingEmailSubject">Subject</label>
              <input type="text" id="marketingEmailSubject" placeholder="e.g. New Hawaii art now available">
            </div>
            <div class="field-group">
              <label for="marketingEmailBody">Message</label>
              <textarea id="marketingEmailBody" rows="5" placeholder="Write your email here..."></textarea>
            </div>
            <div style="display:flex; align-items:center; gap:12px;">
              <button class="btn btn-primary btn-sm" type="button" id="sendMarketingEmailBtn">Send email</button>
              <button class="btn btn-secondary btn-sm" type="button" id="cancelMarketingEmailBtn">Cancel</button>
              <span id="marketingEmailStatus" style="font-size:0.85rem;"></span>
            </div>
          </div>
        <% } %>
      </div>
      <% if (blockedEmails.length > 0) { %>
        <div class="admin-card">
          <h3>Blocked senders</h3>
          <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">Messages from these addresses are silently ignored — no email lands in your inbox, and nothing shows in your Messages list.</p>
          <% blockedEmails.forEach(function(b) { %>
            <div style="display:flex; justify-content:space-between; align-items:center; padding: 8px 0; border-bottom: 1px solid var(--sand-line);">
              <div>
                <%= b.email %>
                <span style="font-size:0.76rem; color:var(--ink-soft);">— blocked <%= b.blocked_at %></span>
              </div>
              <form method="POST" action="/admin/blocked-emails/<%= b.id %>/unblock">
                <button class="btn btn-secondary btn-sm" type="submit">Unblock</button>
              </form>
            </div>
          <% }); %>
        </div>
      <% } %>
  </div>
</main>

<%- include('../partials/site-footer') %>
<script src="/js/admin.js"></script>
<script>
  (function () {
    const dropzone = document.getElementById('bulkDropzone');
    const fileInput = document.getElementById('bulkImages');
    const dropzoneText = document.getElementById('dropzoneText');
    const fileList = document.getElementById('dropzoneFileList');
    const submitBtn = document.getElementById('bulkSubmitBtn');
    if (!dropzone) return;

    function renderFileList(files) {
      if (!files || files.length === 0) {
        dropzoneText.textContent = 'Drag images here, or click to browse';
        fileList.textContent = '';
        return;
      }
      dropzoneText.textContent = `${files.length} image${files.length === 1 ? '' : 's'} ready to add:`;
      fileList.textContent = Array.from(files).map(f => f.name).join(', ');
    }

    dropzone.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', () => renderFileList(fileInput.files));

    ['dragenter', 'dragover'].forEach(evt => {
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('dropzone-active');
      });
    });

    ['dragleave', 'drop'].forEach(evt => {
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('dropzone-active');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      const files = e.dataTransfer.files;
      if (files && files.length) {
        fileInput.files = files;
        renderFileList(files);
      }
    });

    dropzone.closest('form').addEventListener('submit', () => {
      if (fileInput.files.length > 0) {
        submitBtn.disabled = true;
        submitBtn.textContent = `Adding ${fileInput.files.length} pieces…`;
      }
    });
  })();
</script>
