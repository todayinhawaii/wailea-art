<% pageTitle = 'Wholesale Outreach — Wailea Art' %>
<% noIndex = true %>
<%- include('../partials/header') %>

<main class="wrap admin-shell">
  <div class="admin-header">
    <h1 style="margin:0;">Wholesale Outreach</h1>
    <a class="btn btn-secondary btn-sm" href="/admin">Back to admin</a>
  </div>

  <% if (!anthropicConfigured) { %>
    <div class="alert" style="background:#fdf6e3; border:1px solid #e8d9a8; padding:12px 16px; border-radius:var(--radius); margin-bottom:20px;">
      AI drafting isn't connected yet — add <code>ANTHROPIC_API_KEY</code> as an environment variable in Render to enable "Generate with AI."
    </div>
  <% } %>

  <div class="outreach-split">
    <div class="outreach-sidebar" id="outreachSidebar">
      <div class="outreach-sidebar-item outreach-new-item active" data-id="new">
        <strong style="font-size:0.9rem;">+ New email</strong>
        <div style="font-size:0.78rem; color:var(--ink-soft); margin-top:2px;">Type any address and send</div>
      </div>
      <% contacts.forEach(function(c) { %>
        <div class="outreach-sidebar-item" data-id="<%= c.id %>">
          <strong style="font-size:0.9rem;"><%= c.email %></strong>
          <% if (c.label) { %><div style="font-size:0.78rem; color:var(--ink-soft); margin-top:2px;"><%= c.label %></div><% } %>
          <div style="font-size:0.72rem; margin-top:3px; color:var(--ocean);">Sent <%= c.times_sent %>x<% if (c.last_sent_at) { %> &middot; last <%= c.last_sent_at.split(' ')[0] %><% } %></div>
        </div>
      <% }); %>
      <% if (contacts.length === 0) { %>
        <div style="padding:16px; font-size:0.82rem; color:var(--ink-soft);">No saved contacts yet — send your first email and it'll show up here automatically.</div>
      <% } %>
    </div>

    <div class="outreach-main">
      <div class="admin-card" id="outreachEditor" style="margin-bottom:20px;">
        <!-- Filled in by JS -->
      </div>

      <div class="admin-card" style="padding:0; overflow:hidden;">
        <div style="padding:10px 16px; border-bottom:1px solid var(--sand-line); font-size:0.8rem; color:var(--ink-soft);">
          Live preview — exactly what will be sent
        </div>
        <iframe id="outreachPreviewFrame" style="width:100%; height:900px; border:0; display:block;"></iframe>
      </div>
    </div>
  </div>
</main>

<script type="application/json" id="contactsData"><%- JSON.stringify(contacts) %></script>
<script>window.ANTHROPIC_CONFIGURED = <%= anthropicConfigured ? 'true' : 'false' %>;</script>

<%- include('../partials/site-footer') %>
<script src="/js/outreach.js"></script>
