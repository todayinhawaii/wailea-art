<% pageTitle = 'Wholesale Outreach — Wailea Art' %>
<% noIndex = true %>
<%- include('../partials/header') %>

<main class="wrap admin-shell">
  <div class="admin-header">
    <h1 style="margin:0;">Wholesale Outreach</h1>
    <a class="btn btn-secondary btn-sm" href="/admin">Back to admin</a>
  </div>

  <% if (importError) { %>
    <div class="alert alert-error"><%= decodeURIComponent(importError) %></div>
  <% } %>
  <% if (importedCount !== undefined) { %>
    <div class="alert alert-success">
      Imported <%= importedCount %> lead<%= importedCount == 1 ? '' : 's' %>.
      <% if (skippedDuplicate > 0) { %> Skipped <%= skippedDuplicate %> already in your list.<% } %>
      <% if (skippedNoBusinessName > 0) { %> Skipped <%= skippedNoBusinessName %> row(s) missing a business name.<% } %>
    </div>
  <% } %>

  <% if (!anthropicConfigured) { %>
    <div class="alert" style="background:#fdf6e3; border:1px solid #e8d9a8; padding:12px 16px; border-radius:var(--radius); margin-bottom:20px;">
      AI drafting isn't connected yet — add <code>ANTHROPIC_API_KEY</code> as an environment variable in Render to enable "Generate draft."
    </div>
  <% } %>

  <details class="admin-card" style="margin-bottom:16px;">
    <summary style="cursor:pointer; font-weight:bold;">Import leads &amp; filters</summary>
    <div style="margin-top:16px;">
      <form method="POST" action="/admin/outreach/import" enctype="multipart/form-data" class="stack" style="margin-bottom:20px;">
        <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:0;">Upload a CSV with columns like Priority, Business, Location, Email, Website, Contact, Type, Why_Fit, Phone, Notes. Works for any region — Hawaii, other states, anywhere.</p>
        <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
          <div class="field-group" style="margin:0; flex:1; min-width:200px;">
            <label for="region">Region / state label</label>
            <input type="text" id="region" name="region" placeholder="e.g. Hawaii - Maui, or California" required>
          </div>
          <div class="field-group" style="margin:0;">
            <label for="csv">CSV file</label>
            <input type="file" id="csv" name="csv" accept=".csv" required>
          </div>
          <button class="btn btn-primary btn-sm" type="submit">Import CSV</button>
        </div>
      </form>

      <p style="font-size:0.85rem;"><strong>Pipeline (<%= totalLeads %> total):</strong>
        <% statusCounts.forEach(function(s) { %> <%= s.status %>: <%= s.c %> &middot; <% }); %>
        <% if (noEmailCount > 0) { %>no direct email: <%= noEmailCount %><% } %>
      </p>

      <form method="GET" action="/admin/outreach" style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
        <div class="field-group" style="margin:0; flex:1; min-width:160px;">
          <label for="search">Search business name</label>
          <input type="text" id="search" name="search" value="<%= search %>">
        </div>
        <div class="field-group" style="margin:0;">
          <label for="region_filter">Region</label>
          <select id="region_filter" name="region">
            <option value="">All regions</option>
            <% regions.forEach(function(r) { %>
              <option value="<%= r %>" <%= region === r ? 'selected' : '' %>><%= r %></option>
            <% }); %>
          </select>
        </div>
        <div class="field-group" style="margin:0;">
          <label for="priority_filter">Priority</label>
          <select id="priority_filter" name="priority">
            <option value="">All</option>
            <option value="A+" <%= priority === 'A+' ? 'selected' : '' %>>A+</option>
            <option value="A" <%= priority === 'A' ? 'selected' : '' %>>A</option>
            <option value="B+" <%= priority === 'B+' ? 'selected' : '' %>>B+</option>
          </select>
        </div>
        <div class="field-group" style="margin:0;">
          <label for="status_filter">Status</label>
          <select id="status_filter" name="status">
            <option value="">All</option>
            <option value="new" <%= status === 'new' ? 'selected' : '' %>>New</option>
            <option value="drafted" <%= status === 'drafted' ? 'selected' : '' %>>Drafted</option>
            <option value="sent" <%= status === 'sent' ? 'selected' : '' %>>Sent</option>
            <option value="replied" <%= status === 'replied' ? 'selected' : '' %>>Replied</option>
          </select>
        </div>
        <button class="btn btn-secondary btn-sm" type="submit">Filter</button>
        <a class="btn btn-secondary btn-sm" href="/admin/outreach">Clear</a>
      </form>

      <% if (totalPages > 1) { %>
        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top: 14px;">
          <% for (let n = 1; n <= totalPages; n++) { %>
            <a class="btn btn-sm <%= n === currentPage ? 'btn-primary' : 'btn-secondary' %>"
               href="/admin/outreach?page=<%= n %><%= region ? '&region=' + encodeURIComponent(region) : '' %><%= priority ? '&priority=' + encodeURIComponent(priority) : '' %><%= status ? '&status=' + encodeURIComponent(status) : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">
              <%= n %>
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
  </details>

  <% if (leads.length === 0) { %>
    <div class="admin-card">
      <p style="color:var(--ink-soft);">No leads to show yet. Open "Import leads &amp; filters" above and upload a CSV to get started.</p>
    </div>
  <% } else { %>

    <div class="outreach-split">
      <div class="outreach-sidebar" id="outreachSidebar">
        <% leads.forEach(function(lead, i) { %>
          <div class="outreach-sidebar-item <%= i === 0 ? 'active' : '' %>" data-id="<%= lead.id %>">
            <div style="display:flex; justify-content:space-between; gap:6px;">
              <strong style="font-size:0.88rem;"><%= lead.business_name %></strong>
              <span style="font-size:0.7rem; color:var(--ink-soft); white-space:nowrap;"><%= lead.priority %></span>
            </div>
            <div style="font-size:0.76rem; color:var(--ink-soft);"><%= lead.location %></div>
            <div style="font-size:0.72rem; margin-top:2px;">
              <span class="status-dot status-<%= lead.status %>"></span> <%= lead.status %>
              <% if (!lead.email) { %> &middot; no email<% } %>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="outreach-main">
        <div class="admin-card" id="outreachEditor">
          <!-- Filled in by JS on load / lead selection -->
        </div>

        <div class="admin-card" style="padding:0; overflow:hidden;">
          <div style="padding:10px 16px; border-bottom:1px solid var(--sand-line); font-size:0.8rem; color:var(--ink-soft); display:flex; justify-content:space-between; align-items:center;">
            <span>Live preview — exactly what will be sent</span>
            <a id="openPreviewTab" href="#" target="_blank" rel="noopener" style="font-size:0.8rem;">Open in new tab ↗</a>
          </div>
          <iframe id="outreachPreviewFrame" style="width:100%; height:900px; border:0; display:block;"></iframe>
        </div>
      </div>
    </div>

  <% } %>
</main>

<script type="application/json" id="leadsData"><%- JSON.stringify(leads) %></script>
<script>window.ANTHROPIC_CONFIGURED = <%= anthropicConfigured ? 'true' : 'false' %>;</script>

<%- include('../partials/site-footer') %>
<script src="/js/outreach.js"></script>
