<% pageTitle = 'Wholesale Outreach — Wailea Art' %>
<% noIndex = true %>
<%- include('../partials/header') %>

<main class="wrap admin-shell">
  <div class="admin-header">
    <h1 style="margin:0;">Wholesale Outreach</h1>
    <a class="btn btn-secondary btn-sm" href="/admin">Back to admin</a>
  </div>

  <% if (importError) { %>
    <div class="alert alert-error"><%= decodeURIComponent(importError) %></div>
  <% } %>
  <% if (importedCount !== undefined) { %>
    <div class="alert alert-success">
      Imported <%= importedCount %> lead<%= importedCount == 1 ? '' : 's' %>.
      <% if (skippedDuplicate > 0) { %> Skipped <%= skippedDuplicate %> already in your list.<% } %>
      <% if (skippedNoBusinessName > 0) { %> Skipped <%= skippedNoBusinessName %> row(s) missing a business name.<% } %>
    </div>
  <% } %>

  <% if (!anthropicConfigured) { %>
    <div class="alert" style="background:#fdf6e3; border:1px solid #e8d9a8; padding:12px 16px; border-radius:var(--radius); margin-bottom:20px;">
      AI drafting isn't connected yet — add <code>ANTHROPIC_API_KEY</code> as an environment variable in Render to enable "Generate draft."
    </div>
  <% } %>

  <div class="admin-card" style="max-width:600px;">
    <h3>Import leads</h3>
    <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">Upload a CSV with columns like Priority, Business, Location, Email, Website, Contact, Type, Why_Fit, Phone, Notes. Works for any region — Hawaii, other states, anywhere.</p>
    <form method="POST" action="/admin/outreach/import" enctype="multipart/form-data" class="stack">
      <div class="field-group">
        <label for="region">Region / state label</label>
        <input type="text" id="region" name="region" placeholder="e.g. Hawaii - Maui, or California" required>
      </div>
      <div class="field-group">
        <label for="csv">CSV file</label>
        <input type="file" id="csv" name="csv" accept=".csv" required>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Import CSV</button>
    </form>
  </div>

  <div class="admin-card">
    <h3 style="margin:0 0 10px;">Your pipeline (<%= totalLeads %> total)</h3>
    <div style="display:flex; gap:10px; flex-wrap:wrap; font-size:0.85rem;">
      <% statusCounts.forEach(function(s) { %>
        <span class="checkbox-pill" style="cursor:default;"><%= s.status %>: <%= s.c %></span>
      <% }); %>
      <% if (noEmailCount > 0) { %>
        <span class="checkbox-pill" style="cursor:default; color:var(--ink-soft);">no direct email: <%= noEmailCount %></span>
      <% } %>
    </div>
  </div>

  <div class="admin-card">
    <form method="GET" action="/admin/outreach" style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
      <div class="field-group" style="margin:0; flex:1; min-width:160px;">
        <label for="search">Search business name</label>
        <input type="text" id="search" name="search" value="<%= search %>">
      </div>
      <div class="field-group" style="margin:0;">
        <label for="region_filter">Region</label>
        <select id="region_filter" name="region">
          <option value="">All regions</option>
          <% regions.forEach(function(r) { %>
            <option value="<%= r %>" <%= region === r ? 'selected' : '' %>><%= r %></option>
          <% }); %>
        </select>
      </div>
      <div class="field-group" style="margin:0;">
        <label for="priority_filter">Priority</label>
        <select id="priority_filter" name="priority">
          <option value="">All</option>
          <option value="A+" <%= priority === 'A+' ? 'selected' : '' %>>A+</option>
          <option value="A" <%= priority === 'A' ? 'selected' : '' %>>A</option>
          <option value="B+" <%= priority === 'B+' ? 'selected' : '' %>>B+</option>
        </select>
      </div>
      <div class="field-group" style="margin:0;">
        <label for="status_filter">Status</label>
        <select id="status_filter" name="status">
          <option value="">All</option>
          <option value="new" <%= status === 'new' ? 'selected' : '' %>>New</option>
          <option value="drafted" <%= status === 'drafted' ? 'selected' : '' %>>Drafted</option>
          <option value="sent" <%= status === 'sent' ? 'selected' : '' %>>Sent</option>
          <option value="replied" <%= status === 'replied' ? 'selected' : '' %>>Replied</option>
        </select>
      </div>
      <button class="btn btn-secondary btn-sm" type="submit">Filter</button>
      <a class="btn btn-secondary btn-sm" href="/admin/outreach">Clear</a>
    </form>
  </div>

  <p style="color:var(--ink-soft); font-size:0.85rem;">Showing <%= leads.length %> of <%= totalCount %> matching leads — page <%= currentPage %> of <%= totalPages %>.</p>

  <% leads.forEach(function(lead) { %>
    <div class="admin-card outreach-lead" data-id="<%= lead.id %>">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px;">
        <div>
          <span class="checkbox-pill" style="cursor:default; font-weight:bold;"><%= lead.priority || '—' %></span>
          <strong style="margin-left:8px;"><%= lead.business_name %></strong>
          <span style="color:var(--ink-soft); font-size:0.85rem;"> — <%= lead.location %></span>
        </div>
        <span class="checkbox-pill" style="cursor:default;">status: <%= lead.status %></span>
      </div>

      <p style="font-size:0.85rem; color:var(--ink-soft); margin:8px 0;">
        <%= lead.business_type %><% if (lead.contact_name) { %> &middot; Contact: <%= lead.contact_name %><% } %>
        <% if (lead.website) { %> &middot; <a href="<%= lead.website %>" target="_blank" rel="noopener">Website</a><% } %>
      </p>
      <p style="font-size:0.85rem; color:var(--ink-soft); margin:0 0 8px;"><%= lead.why_fit %></p>

      <% if (!lead.email) { %>
        <p style="font-size:0.82rem; background:#f0eee8; padding:8px 10px; border-radius:4px;">No direct email on file. <%= lead.notes %></p>
      <% } %>

      <div class="draft-area" style="margin-top:10px;">
        <div class="field-group" style="margin-bottom:6px;">
          <label>Subject</label>
          <input type="text" class="draft-subject-input" value="<%= lead.draft_subject || '' %>" placeholder="Generate a draft, or write your own">
        </div>
        <div class="field-group" style="margin-bottom:6px;">
          <label>Body</label>
          <textarea class="draft-body-input" rows="6" placeholder="Generate a draft, or write your own"><%= lead.draft_body || '' %></textarea>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
          <% if (anthropicConfigured) { %>
            <button class="btn btn-secondary btn-sm generate-draft-btn" type="button">✨ Generate draft</button>
          <% } %>
          <button class="btn btn-secondary btn-sm save-draft-btn" type="button">Save draft</button>
          <a class="btn btn-secondary btn-sm" href="/admin/outreach/<%= lead.id %>/preview" target="_blank" rel="noopener">👁️ Preview design</a>
          <% if (lead.email) { %>
            <button class="btn btn-primary btn-sm send-outreach-btn" type="button">Send email</button>
          <% } %>
          <% if (lead.status === 'sent') { %>
            <form method="POST" action="/admin/outreach/<%= lead.id %>/mark-replied">
              <button class="btn btn-secondary btn-sm" type="submit">Mark as replied</button>
            </form>
          <% } %>
          <form method="POST" action="/admin/outreach/<%= lead.id %>/delete" onsubmit="return confirm('Delete this lead? This cannot be undone.');">
            <button class="btn btn-sm" style="background:var(--danger); color:#fff;" type="submit">Delete</button>
          </form>
          <span class="draft-status" style="font-size:0.82rem;"></span>
        </div>
      </div>
    </div>
  <% }); %>

  <% if (totalPages > 1) { %>
    <div style="display:flex; gap:6px; flex-wrap:wrap; margin: 20px 0;">
      <% for (let n = 1; n <= totalPages; n++) { %>
        <a class="btn btn-sm <%= n === currentPage ? 'btn-primary' : 'btn-secondary' %>"
           href="/admin/outreach?page=<%= n %><%= region ? '&region=' + encodeURIComponent(region) : '' %><%= priority ? '&priority=' + encodeURIComponent(priority) : '' %><%= status ? '&status=' + encodeURIComponent(status) : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">
          <%= n %>
        </a>
      <% } %>
    </div>
  <% } %>
</main>

<%- include('../partials/site-footer') %>
<script src="/js/outreach.js"></script>
