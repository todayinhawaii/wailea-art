<% pageTitle = (post ? 'Edit post' : 'Write new post') + ' — Wailea Art' %>
<% noIndex = true %>
<%- include('../partials/header') %>

<main class="wrap admin-shell">
  <div class="admin-header">
    <h1 style="margin:0;"><%= post ? 'Edit post' : 'Write new post' %></h1>
    <a class="btn btn-secondary btn-sm" href="/admin">Back to admin</a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="admin-card" style="max-width: 720px;">
    <% if (post) { %>
      <div style="margin-bottom: 18px;">
        <% if (/\.(mp4|webm|mov)$/i.test(post.featured_image)) { %>
          <video src="<%= post.featured_image %>" style="max-width: 220px; border-radius: 3px; border: 1px solid var(--sand-line);" controls muted></video>
        <% } else { %>
          <img src="<%= post.featured_image %>" alt="<%= post.title %>" style="max-width: 220px; border-radius: 3px; border: 1px solid var(--sand-line);">
        <% } %>
      </div>
    <% } %>

    <form method="POST" action="<%= post ? '/admin/posts/' + post.id : '/admin/posts' %>" enctype="multipart/form-data" class="stack" id="postForm">
      <div class="field-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required>
      </div>

      <div class="field-group">
        <label for="featured_image"><%= post ? 'Replace cover — image or video (optional)' : 'Cover — image or video' %></label>
        <input type="file" id="featured_image" name="featured_image" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" <%= post ? '' : 'required' %>>
        <p style="font-size: 0.82rem; color: var(--ink-soft); margin: 6px 0 0;">A short video will autoplay (silently, on a loop) when someone lands on the post — great for a bit of motion, but keep it brief and lightweight so the page still loads fast.</p>
      </div>

      <div class="field-group">
        <label for="excerpt">Short summary (optional — used for previews and search engines; auto-generated from your post if left blank)</label>
        <textarea id="excerpt" name="excerpt" rows="2"><%= post ? post.excerpt : '' %></textarea>
      </div>

      <div class="field-group">
        <label>Post content</label>
        <div id="editor"><%- post ? post.content : '' %></div>
        <input type="hidden" name="content" id="contentInput">
      </div>

      <button class="btn btn-primary btn-block" type="submit"><%= post ? 'Save changes' : 'Publish post' %></button>
    </form>
  </div>
</main>

<%- include('../partials/site-footer') %>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script>
  const quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
      toolbar: [
        [{ header: [2, 3, false] }],
        ['bold', 'italic', 'underline'],
        ['blockquote'],
        [{ list: 'ordered' }, { list: 'bullet' }],
        ['link', 'image'],
        ['clean']
      ]
    }
  });

  document.getElementById('postForm').addEventListener('submit', function () {
    document.getElementById('contentInput').value = document.querySelector('#editor .ql-editor').innerHTML;
  });
</script>

<style>
  #editor { background: var(--card); min-height: 300px; }
  .ql-toolbar.ql-snow { border-color: var(--sand-line); background: var(--sand); border-radius: 3px 3px 0 0; }
  .ql-container.ql-snow { border-color: var(--sand-line); border-radius: 0 0 3px 3px; font-family: 'Work Sans', sans-serif; font-size: 0.95rem; }
</style>
