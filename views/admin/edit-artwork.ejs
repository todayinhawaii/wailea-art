<% pageTitle = 'Edit art — Wailea Art' %>
<% noIndex = true %>
<%- include('../partials/header') %>

<main class="wrap admin-shell">
  <div class="admin-header">
    <h1 style="margin:0;">Edit art</h1>
    <a class="btn btn-secondary btn-sm" href="/admin">Back to admin</a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="admin-card" style="max-width: 560px;">
    <div style="margin-bottom: 18px;">
      <img src="<%= artwork.image_path %>" alt="<%= artwork.title %>" style="max-width: 160px; border-radius: 3px; border: 1px solid var(--sand-line);">
      <div style="margin-top: 8px;">
        <a class="btn btn-secondary btn-sm" href="/admin/artworks/<%= artwork.id %>/original">Download original (full resolution)</a>
      </div>
    </div>

    <form method="POST" action="/admin/artworks/<%= artwork.id %>" enctype="multipart/form-data" class="stack">
      <div class="field-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= artwork.title %>" required>
      </div>
      <div class="field-group">
        <label for="sku">Internal reference / SKU (optional — only you see this, never shown publicly)</label>
        <input type="text" id="sku" name="sku" value="<%= artwork.sku || '' %>" placeholder="e.g. RT 537">
      </div>
      <div class="field-group">
        <label for="description">Description (optional)</label>
        <textarea id="description" name="description" rows="3"><%= artwork.description %></textarea>
      </div>
      <div class="field-group">
        <label for="dimensions">Dimensions</label>
        <input type="text" id="dimensions" name="dimensions" value="<%= artwork.dimensions %>">
      </div>
      <div class="field-group">
        <label for="material">Material</label>
        <input type="text" id="material" name="material" value="<%= artwork.material %>" placeholder="e.g. Giclée print on fine art paper">
      </div>
      <div class="field-group">
        <label class="checkbox-pill" style="width: fit-content;">
          <input type="checkbox" name="ships_as_canvas" value="1" <%= artwork.ships_as_canvas ? 'checked' : '' %>>
          <span>This ships as a rolled canvas (in a tube)</span>
        </label>
      </div>
      <div class="field-group">
        <label for="image">Replace main image (optional — leave blank to keep current image)</label>
        <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp">
      </div>

      <% if (categories.length > 0) { %>
        <div class="field-group">
          <label>Categories</label>
          <div class="checkbox-grid">
            <% categories.forEach(function(cat) { %>
              <label class="checkbox-pill">
                <input type="checkbox" name="category_ids" value="<%= cat.id %>" <%= selectedIds.includes(cat.id) ? 'checked' : '' %>>
                <span><%= cat.name %></span>
              </label>
            <% }); %>
          </div>
        </div>
      <% } %>

      <div class="field-group">
        <label>Pricing</label>
        <div class="price-inputs">
          <div>
            <label for="price_retail" style="margin-bottom:4px;">Retail</label>
            <input type="number" step="0.01" id="price_retail" name="price_retail" value="<%= artwork.price_retail %>">
          </div>
          <div>
            <label for="price_bulk_packaging" style="margin-bottom:4px;">Bulk, packaged</label>
            <input type="number" step="0.01" id="price_bulk_packaging" name="price_bulk_packaging" value="<%= artwork.price_bulk_packaging %>">
          </div>
          <div>
            <label for="price_bulk_no_packaging" style="margin-bottom:4px;">Bulk, no packaging</label>
            <input type="number" step="0.01" id="price_bulk_no_packaging" name="price_bulk_no_packaging" value="<%= artwork.price_bulk_no_packaging %>">
          </div>
        </div>
      </div>

      <button class="btn btn-primary btn-block" type="submit">Save changes</button>
    </form>
  </div>

  <div class="admin-card" style="max-width: 560px;">
    <h3>Carousel images</h3>
    <p style="color: var(--ink-soft); font-size: 0.85rem; margin-top:-6px;">Add more photos of this same piece — once there's more than one image, the gallery card will show left/right arrows so shoppers can browse them.</p>

    <% if (extraImages.length === 0) { %>
      <p style="color: var(--ink-soft); font-size: 0.9rem;">Just the one main image right now — add more below to turn this into a carousel.</p>
    <% } else { %>
      <div class="carousel-thumb-grid">
        <div class="carousel-thumb">
          <img src="<%= artwork.image_path %>" alt="Main image">
          <span class="carousel-thumb-label">Main</span>
        </div>
        <% extraImages.forEach(function(img) { %>
          <div class="carousel-thumb">
            <img src="<%= img.image_path %>" alt="Additional image">
            <a href="/admin/artworks/<%= artwork.id %>/images/<%= img.id %>/original" class="carousel-thumb-download" title="Download original">&#8681;</a>
            <form method="POST" action="/admin/artworks/<%= artwork.id %>/images/<%= img.id %>/delete" onsubmit="return confirm('Remove this image from the carousel?');">
              <button class="btn btn-sm carousel-thumb-delete" style="background:var(--danger); color:#fff;" type="submit">&times;</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>

    <form method="POST" action="/admin/artworks/<%= artwork.id %>/images" enctype="multipart/form-data" class="stack" style="margin-top:16px;">
      <div class="field-group">
        <label for="extra_images">Add image(s)</label>
        <input type="file" id="extra_images" name="extra_images" accept="image/jpeg,image/png,image/webp" multiple>
      </div>
      <button class="btn btn-secondary btn-block" type="submit">Add to carousel</button>
    </form>
  </div>
</main>

<%- include('../partials/site-footer') %>
