<% pageTitle = 'Email Template — Wailea Art' %>
<% noIndex = true %>
<%- include('../partials/header') %>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<main class="wrap admin-shell">
  <div class="admin-header">
    <h1 style="margin:0;">Email Template</h1>
    <a class="btn btn-secondary btn-sm" href="/admin/outreach">Back to Outreach</a>
  </div>

  <% if (saved) { %>
    <div class="alert alert-success">✓ Template saved. New emails will start with this from now on.</div>
  <% } %>

  <div class="admin-card" style="max-width:700px;">
    <p style="color:var(--ink-soft); font-size:0.9rem; margin-top:0;">
      Write the message you want every new outreach email to start with. Once saved, clicking "+ New email" on the
      Outreach page will automatically load this subject and message — you can still edit it per recipient before
      sending, but this is what everyone starts with until you update it here.
    </p>

    <form method="POST" action="/admin/outreach/template" id="templateForm">
      <div class="field-group" style="margin-bottom:10px;">
        <label for="templateSubject">Default subject</label>
        <input type="text" id="templateSubject" name="subject" value="<%= template.subject %>" placeholder="e.g. A note from Wailea Art">
      </div>

      <div class="field-group" style="margin-bottom:10px;">
        <label>Default message</label>
        <div id="templateBodyEditor" style="background:#fff; min-height:220px;"></div>
        <input type="hidden" id="templateBodyInput" name="body">
      </div>

      <button class="btn btn-primary" type="submit">Save template</button>
    </form>
  </div>
</main>

<%- include('../partials/site-footer') %>
<script>
  const quill = new Quill('#templateBodyEditor', {
    theme: 'snow',
    modules: {
      toolbar: [
        [{ header: [false, 2, 3] }],
        ['bold', 'italic', 'underline'],
        [{ color: [] }],
        ['link'],
        ['clean']
      ]
    }
  });

  const savedBody = <%- JSON.stringify(template.body || '') %>;
  if (savedBody) {
    quill.clipboard.dangerouslyPasteHTML(savedBody);
  }

  document.getElementById('templateForm').addEventListener('submit', () => {
    document.getElementById('templateBodyInput').value = quill.root.innerHTML;
  });
</script>
